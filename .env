# Server
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/job_platform
DB_USERNAME=postgres
DB_PASSWORD=0000

# AI Service
AI_ENABLED=true
AI_BASE_URL=http://localhost:8000
AI_TIMEOUT=120s
AI_CONNECT_TIMEOUT=30s
AI_READ_TIMEOUT=120s

# Providers
ARBEITNOW_ENABLED=true
REMOTEOK_ENABLED=true

JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata